{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "noboard-crash-report",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "noboard-crash-reports",
      // 部署前用 `wrangler d1 create noboard-crash-reports` 返回的 ID 替换。
      "database_id": "4ad8a912-685b-450f-bcec-683d4b8566b8",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "REPORT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ],
  "secrets": {
    "required": ["FEISHU_WEBHOOK_URL", "REPORT_INGEST_TOKEN", "GITHUB_TOKEN"]
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  }
}
